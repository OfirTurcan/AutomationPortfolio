---
import "@fontsource-variable/heebo";
import "../styles/global.css";
import A11yMenu from "../components/A11yMenu.astro";
import ContactModal from "../components/ContactModal.astro";
import { basePath, langOf, localePath, type Dict } from "../lib/i18n";

interface Props {
  /** Full translation dictionary for this page (both languages); also embedded for scripts. */
  dict: Dict;
  /** Optional schema.org structured data for this page. */
  jsonLd?: unknown;
}

const { dict, jsonLd } = Astro.props;
// Hebrew at /…, English at /en/… (text translated at build time by src/middleware.ts).
const lang = langOf(Astro.url);
const dir = lang === "he" ? "rtl" : "ltr";
const title = dict.__title?.[lang] ?? "SyncMoto";
const description = dict.__desc?.[lang] ?? "";
const hePath = basePath(Astro.url);
const heUrl = new URL(hePath, Astro.site).href;
const enUrl = new URL(localePath(hePath, "en"), Astro.site).href;
// Social previews need absolute URLs (WhatsApp/LinkedIn/Facebook ignore relative ones).
const ogImage = new URL("/images/og-image.jpg", Astro.site).href;
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
---

<!doctype html>
<html lang={lang} dir={dir} class="no-js">
  <head>
    <meta charset="UTF-8" />
    <!-- Returning visitors who chose English go straight to the English page.
         Runs before anything renders; crawlers have no stored choice, so never redirect. -->
    <script is:inline>
      (function () {
        try {
          var p = location.pathname;
          var onEn = p === "/en" || p.indexOf("/en/") === 0;
          if (!onEn && localStorage.getItem("lang") === "en") {
            location.replace("/en" + (p === "/" ? "/" : p) + location.search + location.hash);
          }
        } catch (e) {}
      })();
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon-32.png" />
    <link rel="apple-touch-icon" href="/images/apple-touch-icon.png" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="canonical" href={pageUrl} />
    <link rel="alternate" hreflang="he" href={heUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="x-default" href={heUrl} />
    <meta property="og:locale" content={lang === "he" ? "he_IL" : "en_US"} />
    <meta property="og:locale:alternate" content={lang === "he" ? "en_US" : "he_IL"} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#f6faff" />
    {
      jsonLd && (
        <script
          type="application/ld+json"
          is:inline
          set:html={JSON.stringify(jsonLd).replace(/</g, "\\u003c")}
        />
      )
    }
  </head>
  <body class="relative">
    <a href="#main" class="skip-link" data-i18n="skip_to_content">דלג לתוכן הראשי</a>

    <A11yMenu />
    <ContactModal />

    <div class="relative z-10">
      <slot />
    </div>

    <!-- Serialized translation dictionary (data, not duplicate visible markup). -->
    <script
      type="application/json"
      id="i18n-dict"
      is:inline
      set:html={JSON.stringify(dict)}
    />

    <!-- Deferred, non-blocking enhancements: reveal-on-scroll fallback, hero animation
         pause, and honouring "pause animations" for page-to-page transitions. -->
    <script is:inline>
      (function () {
        document.documentElement.classList.remove("no-js");

        // Page-to-page cross-fade (CSS @view-transition) is skipped when the accessibility
        // menu's "pause animations" is on; reduced motion is handled in CSS.
        window.addEventListener("pageswap", function (e) {
          if (e.viewTransition && document.documentElement.classList.contains("a11y-pause-motion")) {
            e.viewTransition.skipTransition();
          }
        });

        // Reveal-on-scroll fallback: browsers with CSS scroll-driven animations
        // handle .reveal / .meth-arrow in global.css and skip this entirely.
        var sda = window.CSS && CSS.supports("(animation-timeline: view()) and (animation-range: entry)");
        var reveals = sda ? [] : document.querySelectorAll(".reveal, .meth-arrow");
        if (sda) {
          // nothing to do
        } else if ("IntersectionObserver" in window) {
          var io = new IntersectionObserver(
            function (entries) {
              entries.forEach(function (entry) {
                if (entry.isIntersecting) {
                  entry.target.classList.add("is-visible");
                  io.unobserve(entry.target);
                }
              });
            },
            { threshold: 0.12 }
          );
          reveals.forEach(function (el) {
            io.observe(el);
          });
        } else {
          reveals.forEach(function (el) {
            el.classList.add("is-visible");
          });
        }

        // Pause the hero workflow animation while it is off screen.
        var wf = document.querySelector(".wf");
        if (wf && "IntersectionObserver" in window) {
          new IntersectionObserver(function (entries) {
            wf.classList.toggle("is-paused", !entries[0].isIntersecting);
          }).observe(wf);
        }
      })();
    </script>
  </body>
</html>
