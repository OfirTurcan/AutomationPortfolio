---
import "@fontsource-variable/heebo";
import "../styles/global.css";
import A11yMenu from "../components/A11yMenu.astro";
import ContactModal from "../components/ContactModal.astro";
import type { Dict } from "../lib/i18n";

interface Props {
  /** Full translation dictionary, serialized once for the client toggle. */
  dict: Dict;
  /** Optional schema.org structured data for this page. */
  jsonLd?: unknown;
}

const { dict, jsonLd } = Astro.props;
const title = dict.__title?.he ?? "SyncMoto";
const description = dict.__desc?.he ?? "";
// Social previews need absolute URLs (WhatsApp/LinkedIn/Facebook ignore relative ones).
const ogImage = new URL("/images/og-image.jpg", Astro.site).href;
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
---

<!doctype html>
<html lang="he" dir="rtl" class="no-js">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon-32.png" />
    <link rel="apple-touch-icon" href="/images/apple-touch-icon.png" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="canonical" href={pageUrl} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#f6faff" />
    {
      jsonLd && (
        <script
          type="application/ld+json"
          is:inline
          set:html={JSON.stringify(jsonLd).replace(/</g, "\\u003c")}
        />
      )
    }
  </head>
  <body class="relative">
    <a href="#main" class="skip-link" data-i18n="skip_to_content">דלג לתוכן הראשי</a>

    <A11yMenu />
    <ContactModal />

    <div class="relative z-10">
      <slot />
    </div>

    <!-- Serialized translation dictionary (data, not duplicate visible markup). -->
    <script
      type="application/json"
      id="i18n-dict"
      is:inline
      set:html={JSON.stringify(dict)}
    />

    <!-- Deferred, non-blocking: language persistence + reveal-on-scroll.
         Default render is Hebrew/RTL and needs none of this. -->
    <script is:inline>
      (function () {
        document.documentElement.classList.remove("no-js");

        var dictEl = document.getElementById("i18n-dict");
        var dict = {};
        try {
          dict = JSON.parse(dictEl.textContent || "{}");
        } catch (e) {}

        function applyLang(lang) {
          var html = document.documentElement;
          html.lang = lang;
          html.dir = lang === "he" ? "rtl" : "ltr";

          document.querySelectorAll("[data-i18n]").forEach(function (el) {
            var entry = dict[el.getAttribute("data-i18n")];
            if (entry && entry[lang] != null) el.textContent = entry[lang];
          });

          // Attribute translations, format: attr1:dictKey,attr2:dictKey (e.g. aria-label + title)
          document.querySelectorAll("[data-i18n-attr]").forEach(function (el) {
            el.getAttribute("data-i18n-attr")
              .split(",")
              .forEach(function (pair) {
                var bits = pair.split(":");
                var entry = dict[bits[1]];
                if (entry && entry[lang] != null) el.setAttribute(bits[0], entry[lang]);
              });
          });

          if (dict.__title && dict.__title[lang]) document.title = dict.__title[lang];
          var md = document.querySelector('meta[name="description"]');
          if (md && dict.__desc && dict.__desc[lang]) md.setAttribute("content", dict.__desc[lang]);

          document.querySelectorAll("[data-lang-label]").forEach(function (el) {
            el.textContent = lang === "he" ? "EN" : "עברית";
          });

          try {
            localStorage.setItem("lang", lang);
          } catch (e) {}
        }

        window.__setLang = applyLang;
        // Cross-fade the language switch (RTL <-> LTR) with a view transition where
        // supported, unless the visitor asked for less motion.
        window.__toggleLang = function () {
          var html = document.documentElement;
          var next = html.lang === "he" ? "en" : "he";
          var calm =
            window.matchMedia("(prefers-reduced-motion: reduce)").matches ||
            html.classList.contains("a11y-pause-motion");
          if (!document.startViewTransition || calm) return applyLang(next);
          document.startViewTransition(function () {
            applyLang(next);
          });
        };

        // Progressive enhancement: restore a previously chosen language.
        try {
          if (localStorage.getItem("lang") === "en") applyLang("en");
        } catch (e) {}

        // Reveal-on-scroll fallback: browsers with CSS scroll-driven animations
        // handle .reveal / .meth-arrow in global.css and skip this entirely.
        var sda = window.CSS && CSS.supports("(animation-timeline: view()) and (animation-range: entry)");
        var reveals = sda ? [] : document.querySelectorAll(".reveal, .meth-arrow");
        if (sda) {
          // nothing to do
        } else if ("IntersectionObserver" in window) {
          var io = new IntersectionObserver(
            function (entries) {
              entries.forEach(function (entry) {
                if (entry.isIntersecting) {
                  entry.target.classList.add("is-visible");
                  io.unobserve(entry.target);
                }
              });
            },
            { threshold: 0.12 }
          );
          reveals.forEach(function (el) {
            io.observe(el);
          });
        } else {
          reveals.forEach(function (el) {
            el.classList.add("is-visible");
          });
        }

        // Pause the hero workflow animation while it is off screen.
        var wf = document.querySelector(".wf");
        if (wf && "IntersectionObserver" in window) {
          new IntersectionObserver(function (entries) {
            wf.classList.toggle("is-paused", !entries[0].isIntersecting);
          }).observe(wf);
        }
      })();
    </script>
  </body>
</html>
