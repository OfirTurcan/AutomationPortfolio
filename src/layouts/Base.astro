---
import "../styles/global.css";
import A11yMenu from "../components/A11yMenu.astro";
import type { Dict } from "../lib/i18n";

interface Props {
  /** Full translation dictionary, serialized once for the client toggle. */
  dict: Dict;
}

const { dict } = Astro.props;
const title = dict.__title?.he ?? "SyncMoto";
const description = dict.__desc?.he ?? "";
---

<!doctype html>
<html lang="he" dir="rtl" class="no-js">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/images/ofir_profile.png" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="/images/ofir_profile.png" />
    <meta name="theme-color" content="#f6faff" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Heebo:wght@400;500;700;800&family=Rubik:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="relative">
    <a href="#main" class="skip-link" data-i18n="skip_to_content">דלג לתוכן הראשי</a>

    <A11yMenu />

    <div class="relative z-10">
      <slot />
    </div>

    <!-- Serialized translation dictionary (data, not duplicate visible markup). -->
    <script
      type="application/json"
      id="i18n-dict"
      is:inline
      set:html={JSON.stringify(dict)}
    />

    <!-- Deferred, non-blocking: language persistence + reveal-on-scroll.
         Default render is Hebrew/RTL and needs none of this. -->
    <script is:inline>
      (function () {
        document.documentElement.classList.remove("no-js");

        var dictEl = document.getElementById("i18n-dict");
        var dict = {};
        try {
          dict = JSON.parse(dictEl.textContent || "{}");
        } catch (e) {}

        function applyLang(lang) {
          var html = document.documentElement;
          html.lang = lang;
          html.dir = lang === "he" ? "rtl" : "ltr";

          document.querySelectorAll("[data-i18n]").forEach(function (el) {
            var entry = dict[el.getAttribute("data-i18n")];
            if (entry && entry[lang] != null) el.textContent = entry[lang];
          });

          // Attribute translations, format: attr1:dictKey,attr2:dictKey (e.g. aria-label + title)
          document.querySelectorAll("[data-i18n-attr]").forEach(function (el) {
            el.getAttribute("data-i18n-attr")
              .split(",")
              .forEach(function (pair) {
                var bits = pair.split(":");
                var entry = dict[bits[1]];
                if (entry && entry[lang] != null) el.setAttribute(bits[0], entry[lang]);
              });
          });

          if (dict.__title && dict.__title[lang]) document.title = dict.__title[lang];
          var md = document.querySelector('meta[name="description"]');
          if (md && dict.__desc && dict.__desc[lang]) md.setAttribute("content", dict.__desc[lang]);

          document.querySelectorAll("[data-lang-label]").forEach(function (el) {
            el.textContent = lang === "he" ? "EN" : "עברית";
          });

          try {
            localStorage.setItem("lang", lang);
          } catch (e) {}
        }

        window.__setLang = applyLang;
        window.__toggleLang = function () {
          applyLang(document.documentElement.lang === "he" ? "en" : "he");
        };

        // Progressive enhancement: restore a previously chosen language.
        try {
          if (localStorage.getItem("lang") === "en") applyLang("en");
        } catch (e) {}

        // Reveal-on-scroll
        var reveals = document.querySelectorAll(".reveal");
        if ("IntersectionObserver" in window) {
          var io = new IntersectionObserver(
            function (entries) {
              entries.forEach(function (entry) {
                if (entry.isIntersecting) {
                  entry.target.classList.add("is-visible");
                  io.unobserve(entry.target);
                }
              });
            },
            { threshold: 0.12 }
          );
          reveals.forEach(function (el) {
            io.observe(el);
          });
        } else {
          reveals.forEach(function (el) {
            el.classList.add("is-visible");
          });
        }
      })();
    </script>
  </body>
</html>
