---
import settings from "../content/settings.json";

const steps = [
  {
    key: "plan",
    he: settings.methodology_step_plan_he,
    icon: "M12 3a6 6 0 0 0-3.5 10.9c.4.3.6.8.6 1.3V16h5.8v-.8c0-.5.2-1 .6-1.3A6 6 0 0 0 12 3Z M9.5 19h5 M10 21.5h4",
  },
  {
    key: "align",
    he: settings.methodology_step_align_he,
    icon: "M9 11a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z M17 11a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5Z M3.5 19c.6-3 2.7-5 5.5-5s4.9 2 5.5 5 M14.5 19c.4-2.2 1.6-3.8 3.3-4.5c1.7.3 3 1.7 3.7 4.5",
  },
  {
    key: "automate",
    he: settings.methodology_step_automate_he,
    icon: "M9 4.5h6v3H9z M9 16.5h6v3H9z M7 7.5h10v9H7z M4.5 10.5H7 M4.5 13.5H7 M17 10.5h2.5 M17 13.5h2.5",
  },
  {
    key: "deliver",
    he: settings.methodology_step_deliver_he,
    icon: "M4 19.5V13l4-3 4 4 4-6 4 3v8.5 M4 19.5h16",
  },
] as const;
---

<section id="methodology" class="mx-auto max-w-6xl scroll-mt-20 px-5 pb-16 pt-20 md:pb-20 md:pt-24">
  <div class="mx-auto max-w-2xl text-center">
    <h2 class="text-2xl font-extrabold leading-snug md:text-3xl" data-i18n="methodology_title">
      {settings.methodology_title_he}
    </h2>
    <p class="mt-2 text-lg font-medium text-[var(--color-violet)]" data-i18n="methodology_subtitle">
      {settings.methodology_subtitle_he}
    </p>
  </div>

  <div class="mt-10 flex flex-col items-stretch gap-6 sm:flex-row sm:items-center sm:justify-between">
    {
      steps.map((step, i) => (
        <>
          <div class="flex flex-col items-center gap-2 text-center sm:flex-1">
            <div class="glass grid h-14 w-14 place-items-center rounded-full text-[var(--color-cyan)]">
              <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d={step.icon} />
              </svg>
            </div>
            <span class="text-sm font-bold" data-i18n={`methodology_step_${step.key}`}>
              {step.he}
            </span>
          </div>
          {i < steps.length - 1 && (
            <svg
              class="flip-x hidden shrink-0 text-[var(--color-border)] sm:block"
              width="32"
              height="16"
              viewBox="0 0 32 16"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M1 8h27 M22 2l7 6-7 6" />
            </svg>
          )}
        </>
      ))
    }
  </div>
</section>
