---
import settings from "../content/settings.json";
import about from "../content/about.json";
---

<section id="about" class="mx-auto max-w-6xl scroll-mt-20 px-5 py-16 md:py-24">
  <div class="grid items-center gap-10 md:grid-cols-[320px_1fr]">
    <!-- Profile -->
    <div class="reveal mx-auto">
      <div class="relative">
        <div class="decor-glow absolute -inset-3 rounded-full bg-gradient-to-tr from-[var(--color-cyan)] via-[var(--color-violet)] to-[var(--color-magenta)] opacity-40 blur-2xl"></div>
        <img
          src={about.profile_image}
          alt={about.name}
          width="300"
          height="300"
          class="relative aspect-square w-64 rounded-full object-cover glow-ring md:w-72"
        />
        <img
          src="/images/better_together.png"
          alt="Better Together"
          width="360"
          height="120"
          class="pointer-events-none absolute -end-6 -top-6 w-28 -rotate-6 drop-shadow-md md:-end-8 md:-top-8 md:w-32"
        />
      </div>
      <div class="mt-5 text-center">
        <div class="text-lg font-extrabold">{about.name}</div>
        <div class="mt-0.5 text-sm text-[var(--color-muted)]">{about.founder_name}</div>
        <div class="mt-1 text-sm text-[var(--color-muted)]" data-i18n="location">{about.location_he}</div>
        <a
          href={about.linkedin_url}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-2 inline-block text-sm font-semibold text-[var(--color-cyan)] hover:underline"
        >
          LinkedIn ↗
        </a>
      </div>
    </div>

    <!-- Text -->
    <div class="reveal">
      <div class="mb-3 text-sm font-bold uppercase tracking-widest text-[var(--color-violet)]" data-i18n="about_title">
        {settings.about_title_he}
      </div>
      <h2 class="text-2xl font-extrabold leading-snug md:text-3xl" data-i18n="headline">
        {about.headline_he}
      </h2>
      <p class="mt-5 text-base leading-relaxed text-[var(--color-muted)]" data-i18n="about">
        {about.about_he}
      </p>
      <blockquote class="mt-6 border-s-2 border-[var(--color-cyan)] ps-4 text-lg font-semibold italic text-[var(--color-text)]">
        <span data-i18n="catchphrase">{about.catchphrase_he}</span>
      </blockquote>
    </div>
  </div>
</section>
