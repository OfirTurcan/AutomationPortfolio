---
import settings from "../content/settings.json";
import about from "../content/about.json";
const year = new Date().getFullYear();
---

<footer class="mx-auto max-w-6xl px-5 py-10 text-center text-sm text-[var(--color-muted)]">
  <div class="mb-2 font-semibold text-[var(--color-text)]">© {year} {about.name}</div>
  <div data-i18n="footer">{settings.footer_he}</div>
  <div class="mt-3">
    <a href="/accessibility" class="font-semibold text-[var(--color-cyan)] hover:underline" data-i18n="footer_accessibility">
      הצהרת נגישות
    </a>
  </div>
</footer>
