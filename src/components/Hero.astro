---
import settings from "../content/settings.json";
import about from "../content/about.json";
import LangToggle from "./LangToggle.astro";

const nav = [
  { href: "#about", key: "nav_about", he: settings.nav_about_he },
  { href: "#skills", key: "nav_skills", he: settings.nav_skills_he },
  { href: "#portfolio", key: "nav_portfolio", he: settings.nav_portfolio_he },
  { href: "#contact", key: "nav_contact", he: settings.nav_contact_he },
];
---

<header class="sticky top-0 z-50">
  <nav class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-5 py-3" aria-label="Main">
    <a href="#top" class="flex items-center gap-2 font-extrabold tracking-tight">
      <span class="grid h-8 w-8 place-items-center rounded-lg glass text-gradient">OT</span>
      <span class="hidden sm:inline">{about.name}</span>
    </a>
    <div class="flex items-center gap-1">
      <ul class="hidden items-center gap-1 md:flex">
        {
          nav.map((n) => (
            <li>
              <a
                href={n.href}
                class="rounded-lg px-3 py-1.5 text-sm text-[var(--color-muted)] transition hover:text-[var(--color-text)]"
                data-i18n={n.key}
              >
                {n.he}
              </a>
            </li>
          ))
        }
      </ul>
      <LangToggle />
    </div>
  </nav>
</header>

<section id="top" class="relative mx-auto flex max-w-6xl flex-col items-center px-5 pb-16 pt-14 text-center md:pt-24">
  <span class="chip mb-6 animate-float-slow" data-i18n="hero_kicker">{settings.hero_kicker_he}</span>

  <h1 class="max-w-4xl text-4xl font-extrabold leading-tight tracking-tight md:text-6xl">
    <span data-i18n="catchphrase" class="text-gradient">{about.catchphrase_he}</span>
  </h1>

  <p class="mt-6 max-w-2xl text-base leading-relaxed text-[var(--color-muted)] md:text-lg" data-i18n="hero_subheading">
    {settings.hero_subheading_he}
  </p>

  <p class="mt-3 text-sm font-medium text-[var(--color-cyan)]" data-i18n="headline">
    {about.headline_he}
  </p>

  <div class="mt-9 flex flex-wrap items-center justify-center gap-3">
    <a
      href="#portfolio"
      class="rounded-xl bg-gradient-to-r from-[var(--color-cyan)] to-[var(--color-violet)] px-6 py-3 font-bold text-[#05060e] transition hover:opacity-90"
      data-i18n="hero_cta_primary"
    >
      {settings.hero_cta_primary_he}
    </a>
    <a
      href="#contact"
      class="glass rounded-xl px-6 py-3 font-bold text-[var(--color-text)] transition hover:border-[var(--color-cyan)]"
      data-i18n="hero_cta_secondary"
    >
      {settings.hero_cta_secondary_he}
    </a>
  </div>
</section>
