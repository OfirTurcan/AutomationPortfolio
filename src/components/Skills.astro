---
import settings from "../content/settings.json";
import about from "../content/about.json";
---

<section id="skills" class="mx-auto max-w-6xl scroll-mt-20 px-5 py-16 md:py-24">
  <div class="mb-10 text-center">
    <h2 class="text-3xl font-extrabold md:text-4xl">
      <span class="text-gradient" data-i18n="skills_title">{settings.skills_title_he}</span>
    </h2>
    <p class="mx-auto mt-3 max-w-2xl text-[var(--color-muted)]" data-i18n="skills_subtitle">
      {settings.skills_subtitle_he}
    </p>
  </div>

  <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
    {
      about.skills.map((group, i) => (
        <div class="glass reveal rounded-2xl p-5">
          <h3 class="mb-4 text-base font-extrabold text-[var(--color-cyan)]" data-i18n={`skill_group_${i}`}>
            {group.title_he}
          </h3>
          <ul class="flex flex-wrap gap-1.5">
            {group.items.map((item) => (
              <li class="chip">{item}</li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</section>
