---
import type { CollectionEntry } from "astro:content";
import { parseVideoUrl } from "../lib/video";
import { coreDict } from "../lib/dict";

interface Props {
  project: CollectionEntry<"projects">["data"];
  /** Column position, used to stagger the scroll reveal of cards side by side. */
  index?: number;
}

const { project: p, index = 0 } = Astro.props;

const statusStyles: Record<string, string> = {
  live: "text-[var(--color-lime)] border-[color-mix(in_srgb,var(--color-lime)_45%,transparent)] bg-[color-mix(in_srgb,var(--color-lime)_12%,transparent)]",
  "in-progress":
    "text-[var(--color-cyan)] border-[color-mix(in_srgb,var(--color-cyan)_45%,transparent)] bg-[color-mix(in_srgb,var(--color-cyan)_12%,transparent)]",
  prototype:
    "text-[var(--color-magenta)] border-[color-mix(in_srgb,var(--color-magenta)_45%,transparent)] bg-[color-mix(in_srgb,var(--color-magenta)_12%,transparent)]",
};
const badgeClass = statusStyles[p.status] ?? statusStyles.live;
// Server-render the Hebrew label (the page defaults to Hebrew); the toggle swaps it.
const statusLabel = coreDict()[`status_${p.status}`]?.he ?? p.status;
// Video is shown as the thumbnail + play button; the player only loads on click.
const video = parseVideoUrl(p.video_url);
const hasVideo = !!video;
const playIcon = `<svg viewBox="0 0 24 24" width="28" height="28" fill="currentColor"><path d="M8 5.5v13l11-6.5z"/></svg>`;
const dict = coreDict();
const lockIcon = `<svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg>`;
// Each card opens a case-study window (native modal <dialog>); its id doubles as a
// shareable link: /#case-<slug> opens it on load (see src/lib/case-study.ts).
const caseId = `case-${p.slug}`;
const closeIcon = `<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg>`;
const arrowIcon = `<svg class="cs-arrow" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>`;
const links = [
  { url: p.link_live, key: "label_view_live" },
  { url: p.link_caseStudy, key: "label_case" },
  { url: p.link_repo, key: "label_repo" },
].filter((l) => l.url && l.url.trim() !== "");
---

<article class="spot glass reveal group relative flex flex-col overflow-hidden rounded-2xl transition hover:-translate-y-1 hover:glow-ring" style={`--i:${index}`}>
  <span class="spot-layer" aria-hidden="true"></span>

  <!-- Media -->
  <div class="relative aspect-video w-full overflow-hidden bg-[var(--color-bg-soft)]">
    {
      hasVideo ? (
        <button
          type="button"
          class="tst-video h-full w-full"
          data-embed={video!.embedUrl}
          data-kind={video!.provider}
          data-title-key="proj_video_title"
          data-name-key={`proj_${p.slug}_title`}
          data-name={p.title_he}
          data-i18n-attr="aria-label:proj_play_video"
          aria-label="צפייה בהדגמת הפרויקט"
          style={`background-image:url('${p.thumbnail}')`}
        >
          <span class="tst-play" aria-hidden="true">
            <Fragment set:html={playIcon} />
          </span>
        </button>
      ) : (
        <>
          <img
            src={p.thumbnail}
            alt={p.title_he}
            loading="lazy"
            decoding="async"
            class="h-full w-full object-cover opacity-90 transition group-hover:scale-105"
          />
          <div class="media-note">
            <Fragment set:html={lockIcon} />
            <span data-i18n="demo_note">פרוטוטייפ פרטי / דמו זמין לפי בקשה</span>
          </div>
        </>
      )
    }
    <span class={`media-badge media-badge--${p.status}`} style="inset-inline-end: 0.75rem;">
      <span class="media-badge__dot" aria-hidden="true"></span>
      <span data-i18n={`status_${p.status}`}>{statusLabel}</span>
    </span>
    {
      p.featured && (
        <span class="media-badge media-badge--featured" style="inset-inline-start: 0.75rem;">
          <span aria-hidden="true">★</span>
          <span data-i18n="label_featured">מומלץ</span>
        </span>
      )
    }
  </div>

  <!-- Body: the short version; the full story is in the case-study window -->
  <div class="flex flex-1 flex-col gap-4 p-5">
    <div>
      <h3 id={`${caseId}-card-title`} class="text-xl font-extrabold text-[var(--color-text)]" data-i18n={`proj_${p.slug}_title`}>
        {p.title_he}
      </h3>
      {
        (p.tagline_he || p.tagline_en) && (
          <p class="mt-1 text-sm text-[var(--color-cyan)]" data-i18n={`proj_${p.slug}_tagline`}>
            {p.tagline_he}
          </p>
        )
      }
    </div>

    <div class="flex flex-wrap gap-1.5">
      {p.tools.map((tool) => <span class="chip">{tool}</span>)}
    </div>

    <div class="mt-auto flex flex-wrap items-center justify-between gap-3 pt-1">
      <button
        type="button"
        class="cs-open"
        command="show-modal"
        commandfor={caseId}
        aria-describedby={`${caseId}-card-title`}
      >
        <span data-i18n="cs_open">{dict.cs_open.he}</span>
        <Fragment set:html={arrowIcon} />
      </button>
      {
        links.length > 0 && (
          <div class="flex flex-wrap gap-3">
            {links.map((l) => (
              <a
                href={l.url}
                target="_blank"
                rel="noopener noreferrer"
                class="text-sm font-semibold text-[var(--color-cyan)] hover:underline"
                data-i18n={l.key}
              >
                {dict[l.key].he}
              </a>
            ))}
          </div>
        )
      }
    </div>
  </div>
</article>

<!-- Case-study window -->
<dialog id={caseId} class="cs-dialog" closedby="any" aria-labelledby={`${caseId}-title`}>
  <div class="cs-panel">
    <form method="dialog">
      <button class="ck-close" aria-label={dict.cs_close.he} data-i18n-attr="aria-label:cs_close">
        <Fragment set:html={closeIcon} />
      </button>
    </form>

    <header class="cs-head">
      <span class={`chip ${badgeClass}`}>
        <span data-i18n={`status_${p.status}`}>{statusLabel}</span>
      </span>
      <h2 id={`${caseId}-title`} class="cs-title" data-i18n={`proj_${p.slug}_title`}>{p.title_he}</h2>
      {
        (p.tagline_he || p.tagline_en) && (
          <p class="cs-tagline" data-i18n={`proj_${p.slug}_tagline`}>{p.tagline_he}</p>
        )
      }
    </header>

    <div class="cs-grid">
      <div class="cs-main">
        <section class="cs-section">
          <h3 class="cs-h"><span class="cs-num" aria-hidden="true">01</span><span data-i18n="cs_challenge">{dict.cs_challenge.he}</span></h3>
          <p data-i18n={`proj_${p.slug}_description`}>{p.description_he}</p>
        </section>

        {
          p.highlights_he && p.highlights_he.length > 0 && (
            <section class="cs-section">
              <h3 class="cs-h"><span class="cs-num" aria-hidden="true">02</span><span data-i18n="cs_built">{dict.cs_built.he}</span></h3>
              <ul class="cs-list">
                {p.highlights_he.map((_h, i) => (
                  <li data-i18n={`proj_${p.slug}_hl_${i}`}>{p.highlights_he?.[i]}</li>
                ))}
              </ul>
            </section>
          )
        }

        <section class="cs-section cs-result">
          <h3 class="cs-h">
            <span class="cs-num" aria-hidden="true">{p.highlights_he && p.highlights_he.length > 0 ? "03" : "02"}</span>
            <span data-i18n="cs_result">{dict.cs_result.he}</span>
          </h3>
          <p data-i18n={`proj_${p.slug}_outcome`}>{p.outcome_he}</p>
        </section>
      </div>

      <aside class="cs-aside">
        <div class="cs-media">
          {
            hasVideo ? (
              <button
                type="button"
                class="tst-video h-full w-full"
                data-embed={video!.embedUrl}
                data-kind={video!.provider}
                data-title-key="proj_video_title"
                data-name-key={`proj_${p.slug}_title`}
                data-name={p.title_he}
                data-i18n-attr="aria-label:proj_play_video"
                aria-label="צפייה בהדגמת הפרויקט"
                style={`background-image:url('${p.thumbnail}')`}
              >
                <span class="tst-play" aria-hidden="true">
                  <Fragment set:html={playIcon} />
                </span>
              </button>
            ) : (
              <img src={p.thumbnail} alt="" loading="lazy" decoding="async" />
            )
          }
        </div>

        <h3 class="cs-h cs-h--small" data-i18n="cs_tools">{dict.cs_tools.he}</h3>
        <div class="flex flex-wrap gap-1.5">
          {p.tools.map((tool) => <span class="chip">{tool}</span>)}
        </div>
        <div class="mt-3 flex flex-wrap gap-x-2 gap-y-1">
          {p.tags.map((tag) => <span class="text-xs text-[var(--color-muted)]">#{tag}</span>)}
        </div>

        {
          links.length > 0 && (
            <div class="mt-4 flex flex-wrap gap-3">
              {links.map((l) => (
                <a
                  href={l.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-sm font-semibold text-[var(--color-cyan)] hover:underline"
                  data-i18n={l.key}
                >
                  {dict[l.key].he}
                </a>
              ))}
            </div>
          )
        }
      </aside>
    </div>
  </div>
</dialog>

<script>
  import "../lib/video-facade";
  import "../lib/spotlight";
  import "../lib/case-study";
</script>
