---
// FAQ section (native <details> accordion, no JavaScript). Content lives in
// src/content/faq.json and is edited in the CMS (Site Content → FAQ). The section stays
// hidden until "Show section" is ticked, and only then is it added to the structured
// data (FAQPage) that search engines and AI assistants read.
import faq from "../content/faq.json";

const items = faq.items ?? [];
const show = faq.show_section && items.length > 0;
---

{
  show && (
    <section id="faq" class="mx-auto max-w-3xl scroll-mt-20 px-5 py-16 md:py-24" aria-labelledby="faq-heading">
      <div class="mb-10 text-center">
        <h2 id="faq-heading" class="text-3xl font-extrabold md:text-4xl">
          <span class="text-gradient" data-i18n="faq_title">{faq.title_he}</span>
        </h2>
        <p class="mx-auto mt-3 max-w-2xl text-[var(--color-muted)]" data-i18n="faq_subtitle">
          {faq.subtitle_he}
        </p>
      </div>

      <div class="flex flex-col gap-3">
        {items.map((item, i) => (
          <details class="faq-item glass reveal rounded-2xl" style={`--i:${i % 3}`}>
            <summary>
              <span data-i18n={`faq_q_${i}`}>{item.question_he}</span>
            </summary>
            <div class="faq-answer" data-i18n={`faq_a_${i}`}>
              {item.answer_he}
            </div>
          </details>
        ))}
      </div>
    </section>
  )
}
