---
// "Which task would you love to stop doing by hand?" — a low-friction call to action
// between the projects and the rest of the page. The main button opens the contact form
// (whose message field asks about exactly that); the booking link appears when set.
// All text is edited in the CMS (Site Settings → First-task call to action).
import settings from "../content/settings.json";
import BookingLink from "./BookingLink.astro";

const points = [1, 2, 3]
  .map((n) => ({ key: `task_point${n}`, he: (settings as Record<string, string>)[`task_point${n}_he`] ?? "" }))
  .filter((p) => p.he.trim() !== "");
const check = `<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>`;
---

<section id="first-task" class="mx-auto max-w-4xl scroll-mt-20 px-5 py-12 md:py-16" aria-labelledby="first-task-heading">
  <div class="glass reveal relative overflow-hidden rounded-3xl p-8 text-center md:p-12">
    <div class="decor-glow absolute -top-24 left-1/2 h-48 w-48 -translate-x-1/2 rounded-full bg-[var(--color-cyan)] opacity-25 blur-3xl"></div>

    <h2 id="first-task-heading" class="relative text-2xl font-extrabold leading-snug md:text-3xl">
      <span class="text-gradient" data-i18n="task_title">{settings.task_title_he}</span>
    </h2>
    <p class="relative mx-auto mt-4 max-w-2xl leading-relaxed text-[var(--color-muted)]" data-i18n="task_text">
      {settings.task_text_he}
    </p>

    <div class="relative mt-8 flex flex-wrap items-start justify-center gap-3">
      <a
        href="#contact"
        data-open-contact
        class="rounded-xl bg-gradient-to-r from-[var(--color-cyan)] to-[var(--color-violet)] px-7 py-3 font-bold text-[#05060e] transition hover:opacity-90"
        data-i18n="task_cta"
      >
        {settings.task_cta_he}
      </a>
      <BookingLink variant="secondary" />
    </div>

    {
      points.length > 0 && (
        <ul class="relative mt-7 flex flex-wrap items-center justify-center gap-x-6 gap-y-2 text-sm font-semibold text-[var(--color-text)]">
          {points.map((p) => (
            <li class="inline-flex items-center gap-1.5">
              <span class="text-[var(--color-lime)]">
                <Fragment set:html={check} />
              </span>
              <span data-i18n={p.key}>{p.he}</span>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</section>
