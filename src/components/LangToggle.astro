---
// Hebrew <-> English switch. Each language is its own page (/ and /en/), so this is a
// plain link: it works without JavaScript and search engines can follow it. A tiny
// script keeps the current section (#hash) and remembers the choice for next visit.
import { basePath, langOf, localePath } from "../lib/i18n";

const lang = langOf(Astro.url);
const other = lang === "he" ? "en" : "he";
const href = localePath(basePath(Astro.url), other);
---

<a
  href={href}
  hreflang={other}
  lang={other}
  data-lang-switch={other}
  class="chip !text-[0.8rem] !px-3 !py-1.5 hover:!border-[var(--color-cyan)] hover:!text-[var(--color-cyan)] transition cursor-pointer"
  aria-label={other === "en" ? "Switch to English" : "מעבר לעברית"}
>
  <span aria-hidden="true">🌐</span>
  <span>{other === "en" ? "EN" : "עברית"}</span>
</a>

<script is:inline>
  document.addEventListener("click", function (e) {
    var a = e.target.closest && e.target.closest("a[data-lang-switch]");
    if (!a) return;
    try {
      localStorage.setItem("lang", a.getAttribute("data-lang-switch"));
    } catch (err) {}
    if (location.hash) a.href = a.pathname + location.hash;
  });
</script>
