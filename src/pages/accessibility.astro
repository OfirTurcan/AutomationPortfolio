---
import Base from "../layouts/Base.astro";
import Footer from "../components/Footer.astro";
import { coreDict, collectPairs } from "../lib/dict";
import a11y from "../content/accessibility.json";
import type { Dict } from "../lib/i18n";

const dict: Dict = {
  ...coreDict(),
  ...collectPairs(a11y as Record<string, unknown>),
};
a11y.measures_he.forEach((m, i) => {
  dict[`stmt_measure_${i}`] = { he: m, en: a11y.measures_en[i] ?? m };
});
dict.__title = {
  he: `${a11y.title_he} — SyncMoto`,
  en: `${a11y.title_en} — SyncMoto`,
};
---

<Base dict={dict}>
  <header class="mx-auto max-w-3xl px-5 py-6">
    <a href="/" class="text-sm font-semibold text-[var(--color-cyan)] hover:underline" data-i18n="back_home">
      ← חזרה לעמוד הבית
    </a>
  </header>

  <main id="main" tabindex="-1" class="mx-auto max-w-3xl px-5 pb-20">
    <h1 class="text-3xl font-extrabold md:text-4xl">
      <span class="text-gradient" data-i18n="title">{a11y.title_he}</span>
    </h1>

    <div class="mt-6 space-y-5 text-[var(--color-muted)] leading-relaxed">
      <p data-i18n="intro">{a11y.intro_he}</p>
      <p data-i18n="compliance">{a11y.compliance_he}</p>

      <ul class="space-y-2">
        {
          a11y.measures_he.map((_m, i) => (
            <li class="flex gap-2">
              <span class="mt-1 text-[var(--color-cyan)]" aria-hidden="true">▸</span>
              <span data-i18n={`stmt_measure_${i}`}>{a11y.measures_he[i]}</span>
            </li>
          ))
        }
      </ul>

      <p data-i18n="limitations">{a11y.limitations_he}</p>
    </div>

    <!-- Accessibility coordinator (legally required contact) -->
    <section class="glass mt-8 rounded-2xl p-6" aria-labelledby="coord-title">
      <h2 id="coord-title" class="text-lg font-extrabold text-[var(--color-text)]" data-i18n="coordinator_label">
        {a11y.coordinator_label_he}
      </h2>
      <div class="mt-3 space-y-1 text-[var(--color-muted)]">
        <p class="font-semibold text-[var(--color-text)]">{a11y.coordinator_name}</p>
        <p>
          <span aria-hidden="true">✉️</span>
          <a class="text-[var(--color-cyan)] underline" href={`mailto:${a11y.coordinator_email}`}>{a11y.coordinator_email}</a>
        </p>
        {
          a11y.coordinator_phone && a11y.coordinator_phone.trim() !== "" && (
            <p>
              <span aria-hidden="true">☎️</span>
              <a class="text-[var(--color-cyan)] underline" href={`tel:${a11y.coordinator_phone}`}>{a11y.coordinator_phone}</a>
            </p>
          )
        }
      </div>
      <p class="mt-3 text-sm text-[var(--color-muted)]" data-i18n="response">{a11y.response_he}</p>
    </section>

    <p class="mt-6 text-sm text-[var(--color-muted)]">
      <span data-i18n="updated_label">{a11y.updated_label_he}</span>: {a11y.updated_date}
    </p>
  </main>

  <Footer />
</Base>
