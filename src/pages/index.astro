---
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import Methodology from "../components/Methodology.astro";
import About from "../components/About.astro";
import Skills from "../components/Skills.astro";
import Portfolio from "../components/Portfolio.astro";
import Testimonials from "../components/Testimonials.astro";
import Contact from "../components/Contact.astro";
import FAQ from "../components/FAQ.astro";
import Footer from "../components/Footer.astro";
import { getCollection } from "astro:content";
import { coreDict } from "../lib/dict";
import type { Dict } from "../lib/i18n";
import faq from "../content/faq.json";
import { homeJsonLd } from "../lib/structured-data";

// Shared base dictionary (settings + about + skills + static UI labels + SEO).
const dict: Dict = coreDict();

// Project text fields (page-specific).
const projectEntries = await getCollection("projects");
for (const { data: p } of projectEntries) {
  dict[`proj_${p.slug}_title`] = { he: p.title_he, en: p.title_en };
  if (p.tagline_he || p.tagline_en) {
    dict[`proj_${p.slug}_tagline`] = { he: p.tagline_he ?? "", en: p.tagline_en ?? "" };
  }
  dict[`proj_${p.slug}_description`] = { he: p.description_he, en: p.description_en };
  dict[`proj_${p.slug}_outcome`] = { he: p.outcome_he, en: p.outcome_en };
  (p.highlights_he ?? []).forEach((h, i) => {
    dict[`proj_${p.slug}_hl_${i}`] = { he: h, en: p.highlights_en?.[i] ?? h };
  });
}

// Testimonial text fields. English falls back to the Hebrew text when not provided.
const testimonialEntries = await getCollection("testimonials");
for (const { data: t } of testimonialEntries) {
  if (!t.published) continue;
  dict[`tst_${t.slug}_name`] = { he: t.name_he, en: t.name_en || t.name_he };
  dict[`tst_${t.slug}_quote`] = { he: t.quote_he, en: t.quote_en || t.quote_he };
  if (t.role_he || t.role_en) {
    dict[`tst_${t.slug}_role`] = { he: t.role_he ?? "", en: t.role_en || t.role_he || "" };
  }
}
// FAQ text fields. English falls back to the Hebrew text when not provided.
dict.faq_title = { he: faq.title_he, en: faq.title_en || faq.title_he };
dict.faq_subtitle = { he: faq.subtitle_he, en: faq.subtitle_en || faq.subtitle_he };
(faq.items ?? []).forEach((q, i) => {
  dict[`faq_q_${i}`] = { he: q.question_he, en: q.question_en || q.question_he };
  dict[`faq_a_${i}`] = { he: q.answer_he, en: q.answer_en || q.answer_he };
});

const jsonLd = homeJsonLd(Astro.site!);
---

<Base dict={dict} jsonLd={jsonLd}>
  <Hero />
  <main id="main" tabindex="-1">
    <Methodology />
    <About />
    <Skills />
    <Portfolio />
    <Testimonials />
    <FAQ />
    <Contact />
  </main>
  <Footer />
</Base>
