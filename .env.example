# GitHub OAuth app credentials for Decap CMS login (set these in Netlify too).
# Create the app at: https://github.com/settings/developers  (New OAuth App)
#   Homepage URL:               https://ofir-turcan-portfolio.netlify.app
#   Authorization callback URL: https://ofir-turcan-portfolio.netlify.app/callback
# Full walkthrough: docs/github-oauth-setup.md
OAUTH_GITHUB_CLIENT_ID=your_github_oauth_client_id
OAUTH_GITHUB_CLIENT_SECRET=your_github_oauth_client_secret
